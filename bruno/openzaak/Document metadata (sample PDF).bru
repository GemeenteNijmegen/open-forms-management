meta {
  name: Document metadata (sample PDF)
  type: http
  seq: 5
}

get {
  url: {{baseUrlOpenZaakDocuments}}enkelvoudiginformatieobjecten/{{pdfSampleDocumentUuid}}
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 200 metadata for the known ACCP sport PDF sample", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().formaat).to.contain("pdf");
  });
}
