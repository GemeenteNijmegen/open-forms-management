meta {
  name: Document download
  type: http
  seq: 2
}

get {
  url: {{baseUrlOpenZaakDocuments}}enkelvoudiginformatieobjecten/{{documentUuid}}/download
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 200 with a non-empty body", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.not.equal(undefined);
  });
}
