meta {
  name: List sport aanmeldingen ascending multi-order
  type: http
  seq: 3
}

get {
  url: {{baseUrlObjects}}objects?data_attr=formName__exact__Aanmelden%20sportactiviteit&ordering=record__registrationAt,uuid
  body: none
  auth: inherit
}

params:query {
  data_attr: formName__exact__Aanmelden sportactiviteit
  ordering: record__registrationAt,uuid
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns 200 ordered ascending by registrationAt with a uuid tie-break", function () {
    expect(res.getStatus()).to.equal(200);
    const results = res.getBody().results;
    for (let i = 1; i < results.length; i++) {
      const previous = results[i - 1].record.registrationAt;
      const current = results[i].record.registrationAt;
      expect(current >= previous).to.equal(true);
    }
  });
}
