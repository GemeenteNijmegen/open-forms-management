{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets",
      "steps": [
        {
          "spawn": "bundle:app/auth/auth.lambda"
        },
        {
          "spawn": "bundle:app/authorizer/authorizer.lambda"
        },
        {
          "spawn": "bundle:app/home/home.lambda"
        },
        {
          "spawn": "bundle:app/login/login.lambda"
        },
        {
          "spawn": "bundle:app/logout/logout.lambda"
        }
      ]
    },
    "bundle:app/auth/auth.lambda": {
      "name": "bundle:app/auth/auth.lambda",
      "description": "Create a JavaScript bundle from src/app/auth/auth.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/auth/auth.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/auth/auth.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text"
        }
      ]
    },
    "bundle:app/auth/auth.lambda:watch": {
      "name": "bundle:app/auth/auth.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/auth/auth.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/auth/auth.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/auth/auth.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text --watch"
        }
      ]
    },
    "bundle:app/authorizer/authorizer.lambda": {
      "name": "bundle:app/authorizer/authorizer.lambda",
      "description": "Create a JavaScript bundle from src/app/authorizer/authorizer.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/authorizer/authorizer.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/authorizer/authorizer.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text"
        }
      ]
    },
    "bundle:app/authorizer/authorizer.lambda:watch": {
      "name": "bundle:app/authorizer/authorizer.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/authorizer/authorizer.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/authorizer/authorizer.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/authorizer/authorizer.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text --watch"
        }
      ]
    },
    "bundle:app/home/home.lambda": {
      "name": "bundle:app/home/home.lambda",
      "description": "Create a JavaScript bundle from src/app/home/home.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/home/home.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/home/home.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text"
        }
      ]
    },
    "bundle:app/home/home.lambda:watch": {
      "name": "bundle:app/home/home.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/home/home.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/home/home.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/home/home.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text --watch"
        }
      ]
    },
    "bundle:app/login/login.lambda": {
      "name": "bundle:app/login/login.lambda",
      "description": "Create a JavaScript bundle from src/app/login/login.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/login/login.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/login/login.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text"
        }
      ]
    },
    "bundle:app/login/login.lambda:watch": {
      "name": "bundle:app/login/login.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/login/login.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/login/login.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/login/login.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text --watch"
        }
      ]
    },
    "bundle:app/logout/logout.lambda": {
      "name": "bundle:app/logout/logout.lambda",
      "description": "Create a JavaScript bundle from src/app/logout/logout.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/logout/logout.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/logout/logout.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text"
        }
      ]
    },
    "bundle:app/logout/logout.lambda:watch": {
      "name": "bundle:app/logout/logout.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/logout/logout.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/app/logout/logout.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/app/logout/logout.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --loader:.mustache=text --watch"
        }
      ]
    },
    "bundle:copy-web-components": {
      "name": "bundle:copy-web-components",
      "description": "Copy NLDS web component IIFE bundles to static/js/web-components/, stripping CSS injection for CSP compliance",
      "steps": [
        {
          "exec": "node scripts/strip-web-component-css.mjs"
        }
      ]
    },
    "bundle:css-bundle": {
      "name": "bundle:css-bundle",
      "description": "Bundle design system CSS into ds.css",
      "steps": [
        {
          "exec": "esbuild ./src/app/static-resources/static/styles/ds-input.js --bundle --target=node22 --platform=node --outfile=./src/app/static-resources/static/styles/ds.js --loader:.css=css --loader:.mustache=text --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=[name] --sourcemap"
        }
      ]
    },
    "cfn-lint": {
      "name": "cfn-lint",
      "description": "Lint synthesized CloudFormation templates",
      "steps": [
        {
          "exec": "cfn-lint cdk.out/**/*.template.json -i W3005 W2001"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "exec": "git checkout -b scratch",
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout $BRANCH"
        },
        {
          "exec": "git fetch origin",
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard origin/$BRANCH",
          "name": "hard reset to origin commit"
        },
        {
          "exec": "git clean -fdx",
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "spawn": "bundle:css-bundle"
        },
        {
          "spawn": "bundle:copy-web-components"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "exec": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern $@ src test tests projenrc .projenrc.ts",
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "preview": {
      "name": "preview",
      "description": "Render preview HTML for all pages once",
      "steps": [
        {
          "exec": "ts-node -P tsconfig.json --transpile-only -r ./src/preview/mustache-register.js ./src/preview/render-previews.ts"
        }
      ]
    },
    "preview:watch": {
      "name": "preview:watch",
      "description": "Watch templates and re-render preview HTML on changes",
      "steps": [
        {
          "exec": "ts-node -P tsconfig.json --transpile-only -r ./src/preview/mustache-register.js ./src/preview/watch.ts"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true",
        "MAJOR": "0"
      },
      "steps": [
        {
          "exec": "rm -fr dist"
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth"
          ]
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "-q"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "jest --passWithNoTests --updateSnapshot",
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "exec": "jest --watch"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@gemeentenijmegen/components-css,@gemeentenijmegen/design-tokens,@gemeentenijmegen/layout-css,@gemeentenijmegen/semantic-html,@gemeentenijmegen/web-components,@types/aws-lambda,@types/jest,@types/mustache,@types/node,@utrecht/page-body-css,@utrecht/pre-heading-css,@utrecht/rich-text-css,aws-sdk-client-mock,esbuild,eslint-import-resolver-typescript,eslint-plugin-import,jest,projen,ts-jest,ts-node,typescript,@aws-lambda-powertools/logger,@aws-lambda-powertools/metrics,@aws-sdk/client-dynamodb,@aws-sdk/lib-dynamodb,@gemeentenijmegen/apigateway-http,@gemeentenijmegen/aws-constructs,@gemeentenijmegen/cross-region-parameters,@gemeentenijmegen/projen-project-type,@gemeentenijmegen/session,@gemeentenijmegen/utils,chokidar,mustache,openid-client"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@gemeentenijmegen/components-css",
            "@gemeentenijmegen/design-tokens",
            "@gemeentenijmegen/layout-css",
            "@gemeentenijmegen/semantic-html",
            "@gemeentenijmegen/web-components",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/jest",
            "@types/mustache",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "@utrecht/alert-css",
            "@utrecht/button-css",
            "@utrecht/button-group-css",
            "@utrecht/document-css",
            "@utrecht/form-field-css",
            "@utrecht/form-field-description-css",
            "@utrecht/form-field-error-message-css",
            "@utrecht/form-label-css",
            "@utrecht/heading-1-css",
            "@utrecht/heading-2-css",
            "@utrecht/heading-3-css",
            "@utrecht/heading-4-css",
            "@utrecht/heading-5-css",
            "@utrecht/heading-6-css",
            "@utrecht/link-css",
            "@utrecht/page-body-css",
            "@utrecht/paragraph-css",
            "@utrecht/pre-heading-css",
            "@utrecht/rich-text-css",
            "@utrecht/textbox-css",
            "aws-cdk",
            "aws-sdk-client-mock",
            "commit-and-tag-version",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "jest",
            "jest-junit",
            "projen",
            "ts-jest",
            "ts-node",
            "typescript",
            "@aws-lambda-powertools/logger",
            "@aws-lambda-powertools/metrics",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/lib-dynamodb",
            "@gemeentenijmegen/apigateway-http",
            "@gemeentenijmegen/aws-constructs",
            "@gemeentenijmegen/cross-region-parameters",
            "@gemeentenijmegen/projen-project-type",
            "@gemeentenijmegen/session",
            "@gemeentenijmegen/utils",
            "aws-cdk-lib",
            "chokidar",
            "constructs",
            "mustache",
            "openid-client"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
