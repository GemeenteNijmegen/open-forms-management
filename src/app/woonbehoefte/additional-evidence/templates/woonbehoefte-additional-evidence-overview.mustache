{{>header}}
<main id="main-content" class="woonbehoefte-overview">
  <h1 class="utrecht-heading-2">Woonbehoefte</h1>

  <nav class="woonbehoefte-tabs" aria-label="Woonbehoeftenavigatie">
    <a class="woonbehoefte-tabs__link" href="/woonbehoefte">Aanvragen</a>
    <a class="woonbehoefte-tabs__link woonbehoefte-tabs__link--active" href="/woonbehoefte/additional-evidence" aria-current="page">Extra bewijzen</a>
  </nav>

  {{#refreshStarted}}
  <div class="utrecht-alert utrecht-alert--success" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">Verversen gestart. Dit kan enkele minuten duren, ververs deze pagina zo nu en dan.</p>
    </div>
  </div>
  {{/refreshStarted}}
  {{#refreshAlreadyRunning}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">Er loopt al een verversing.</p>
    </div>
  </div>
  {{/refreshAlreadyRunning}}
  {{#refreshFailed}}
  <div class="utrecht-alert utrecht-alert--error" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">Verversen kon niet worden gestart. Probeer het opnieuw.</p>
    </div>
  </div>
  {{/refreshFailed}}
  {{#isRefreshing}}
  <p class="woonbehoefte-loading">Bezig met verversen…</p>
  {{/isRefreshing}}

  <div class="woonbehoefte-refresh-bar">
    <form method="post" action="/woonbehoefte/additional-evidence/refresh">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <button type="submit" class="utrecht-button utrecht-button--secondary-action">Verversen</button>
    </form>
  </div>

  <details class="woonbehoefte-filter">
    <summary class="utrecht-form-label">Zoeken en filteren</summary>
    <form method="get" action="/woonbehoefte/additional-evidence">
      <fieldset>
        <legend class="utrecht-form-label">Status</legend>
        {{#statusOptions}}
        <div class="utrecht-form-field utrecht-form-field--checkbox">
          <input type="checkbox" class="utrecht-form-field__input utrecht-checkbox" id="status-{{value}}" name="status" value="{{value}}" {{#checked}}checked{{/checked}}>
          <label class="utrecht-form-field__label utrecht-form-label utrecht-form-label--checkbox" for="status-{{value}}">{{label}}</label>
        </div>
        {{/statusOptions}}
      </fieldset>

      <button type="submit" class="utrecht-button utrecht-button--primary-action woonbehoefte-filter__submit">Filteren</button>
    </form>
  </details>

  <p class="woonbehoefte-count">{{totalCountLabel}}</p>

  {{#hasRows}}
  <div>
    {{#rows}}
    <article class="nijmegen-search-results woonbehoefte-record">
      <div class="nijmegen-search-results__content">
        <h2 class="nijmegen-search-results__heading utrecht-heading-4">
          {{projectNameLabel}} {{originalCaseReferenceLabel}}
          <span class="woonbehoefte-badge woonbehoefte-badge--{{statusToken}} woonbehoefte-record__status-badge">{{statusLabel}}</span>
        </h2>
        {{#hasSourceError}}
        <p class="utrecht-alert utrecht-alert--warning">
          De brongegevens van deze inzending konden niet volledig worden gelezen. Ververs Extra bewijzen later opnieuw. De inzending blijft in het overzicht staan.
        </p>
        {{/hasSourceError}}
        <div class="woonbehoefte-record__summary">
          <div class="woonbehoefte-record__field">
            <span class="woonbehoefte-record__field-label">Extra inzending</span>
            <span>{{submissionReference}}</span>
          </div>
          <div class="woonbehoefte-record__field">
            <span class="woonbehoefte-record__field-label">Opgegeven hoofdzaak</span>
            <span>{{originalCaseReferenceLabel}}</span>
          </div>
          <div class="woonbehoefte-record__field">
            <span class="woonbehoefte-record__field-label">Ingediend</span>
            <span>{{submittedAtLabel}}</span>
          </div>
        </div>

        <details class="woonbehoefte-details">
          <summary>Meer gegevens</summary>
          <ul class="nijmegen-metadata">
            {{#contactEmail}}<li class="nijmegen-metadata__item">E-mailadres: {{contactEmail}}</li>{{/contactEmail}}
            {{#contactPhone}}<li class="nijmegen-metadata__item">Telefoonnummer: {{contactPhone}}</li>{{/contactPhone}}
            {{#evidenceDescription}}
            <li class="nijmegen-metadata__item">Welke extra bewijzen heeft u toegevoegd?<br>{{evidenceDescription}}</li>
            {{/evidenceDescription}}
            {{#remarks}}
            <li class="nijmegen-metadata__item">Heeft u nog opmerkingen?<br>{{remarks}}</li>
            {{/remarks}}
          </ul>
        </details>

        <p><a class="utrecht-link" href="{{detailHref}}">Bekijk inzending</a></p>
      </div>
    </article>
    {{/rows}}
  </div>
  {{/hasRows}}
  {{^hasRows}}
  <div class="nijmegen-action-card">
    <div class="nijmegen-action-card__content">
      <p class="utrecht-paragraph">Er zijn geen extra bewijzen die aan het huidige filter voldoen.</p>
    </div>
  </div>
  {{/hasRows}}
</main>
{{>footer}}
