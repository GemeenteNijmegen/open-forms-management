{{>header}}
<main id="main-content" class="woonbehoefte-detail">
  <p><a class="utrecht-link" href="{{backHref}}">Terug naar Extra bewijzen</a></p>

  <div class="woonbehoefte-detail-header">
    <p class="woonbehoefte-detail-header__reference">
      {{submissionReference}}
      <span class="woonbehoefte-badge woonbehoefte-badge--{{statusToken}}">{{statusLabel}}</span>
    </p>
    <h1 class="utrecht-heading-2">{{projectNameLabel}}</h1>
    <p class="utrecht-paragraph">Projectnaam opgegeven bij extra bewijzen</p>
  </div>

  {{#canManage}}
  {{^isLinked}}
  <form method="post" action="/woonbehoefte/additional-evidence/{{submissionId}}/status" class="woonbehoefte-inline-form">
    <input type="hidden" name="csrfToken" value="{{csrfToken}}">
    <input type="hidden" name="back" value="{{backQuery}}">
    <div class="utrecht-form-field">
      <label class="utrecht-form-label" for="status-select">Status wijzigen</label>
      <select class="utrecht-select utrecht-select--html-select" id="status-select" name="status">
        {{#statusOptions}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/statusOptions}}
      </select>
    </div>
    <button type="submit" class="utrecht-button utrecht-button--secondary-action">Opslaan</button>
  </form>
  {{/isLinked}}
  {{/canManage}}

  {{#hasSourceError}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">{{sourceErrorMessage}}</p>
    </div>
  </div>
  {{/hasSourceError}}

  {{#savedMessage}}
  <div class="utrecht-alert utrecht-alert--success" role="status">
    <div class="utrecht-alert__content"><p class="utrecht-alert__message">{{savedMessage}}</p></div>
  </div>
  {{/savedMessage}}

  {{#showLinkedConflictWarning}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">Dit workitem is inmiddels gekoppeld en kan niet meer handmatig van status wisselen.</p>
    </div>
  </div>
  {{/showLinkedConflictWarning}}

  {{#linkErrorMessage}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content"><p class="utrecht-alert__message">{{linkErrorMessage}}</p></div>
  </div>
  {{/linkErrorMessage}}

  <section id="basisgegevens" class="woonbehoefte-section">
    <h2 class="utrecht-heading-4">Ingezonden</h2>
    <p class="utrecht-paragraph">{{submittedAtLabel}}</p>

    <h2 class="utrecht-heading-4">Contact</h2>
    <ul class="nijmegen-metadata">
      {{#contactEmail}}<li class="nijmegen-metadata__item">E-mailadres: {{contactEmail}}</li>{{/contactEmail}}
      {{#contactPhone}}<li class="nijmegen-metadata__item">Telefoonnummer: {{contactPhone}}</li>{{/contactPhone}}
    </ul>

    {{#evidenceDescription}}
    <h2 class="utrecht-heading-4">Welke extra bewijzen heeft u toegevoegd?</h2>
    <p class="utrecht-paragraph">{{evidenceDescription}}</p>
    {{/evidenceDescription}}

    {{#remarks}}
    <h2 class="utrecht-heading-4">Heeft u nog opmerkingen?</h2>
    <p class="utrecht-paragraph">{{remarks}}</p>
    {{/remarks}}
  </section>

  <details id="koppelen" class="woonbehoefte-details woonbehoefte-details--section" open>
    <summary class="utrecht-heading-4">Koppelen aan hoofdzaak</summary>

    {{#isLinked}}
    <div class="utrecht-alert utrecht-alert--success" role="status">
      <div class="utrecht-alert__content">
        <p class="utrecht-alert__message">Extra bewijzen zijn gekoppeld aan {{linkedInfo.caseReference}} - {{linkedInfo.projectNameLabel}}.</p>
      </div>
    </div>
    <ul class="nijmegen-metadata">
      <li class="nijmegen-metadata__item">Gekoppeld aan: {{linkedInfo.caseReference}} - {{linkedInfo.projectNameLabel}}</li>
      <li class="nijmegen-metadata__item">Gekoppeld op: {{linkedInfo.linkedAtLabel}}</li>
      <li class="nijmegen-metadata__item">Gekoppeld door: {{linkedInfo.linkedByLabel}}</li>
    </ul>
    <p><a class="utrecht-link" href="{{linkedInfo.caseHref}}">Ga naar hoofdzaak</a></p>
    {{/isLinked}}

    {{^isLinked}}
    <h3 class="utrecht-heading-5">Kenmerk door indiener in formulier</h3>
    <p class="utrecht-paragraph">{{originalCaseReferenceLabel}}</p>

    <form method="post" action="/woonbehoefte/additional-evidence/{{submissionId}}/search-case">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <div class="utrecht-form-field">
        <label class="utrecht-form-label" for="search-case-reference">Kenmerk om te zoeken</label>
        <input type="text" class="utrecht-textbox" id="search-case-reference" name="searchCaseReference" value="{{searchCaseReferenceValue}}">
      </div>
      <p class="utrecht-paragraph">Zoek of er binnen Woonbehoefte een hoofdzaak bestaat met dit kenmerk.</p>
      <button type="submit" class="utrecht-button utrecht-button--primary-action">Zoek hoofdzaak bij kenmerk</button>
    </form>

    {{#caseLookup}}
    {{#searched}}
    <div class="woonbehoefte-case-lookup-result">
    {{#found}}
    <div class="utrecht-alert utrecht-alert--success" role="status">
      <div class="utrecht-alert__content">
        <p class="utrecht-alert__message">Hoofdzaak gevonden</p>
      </div>
    </div>
    <ul class="nijmegen-metadata">
      <li class="nijmegen-metadata__item">Kenmerk hoofdzaak: {{caseReference}}</li>
      <li class="nijmegen-metadata__item">Projectnaam hoofdzaak: {{hoofdzaakProjectNameLabel}}</li>
      <li class="nijmegen-metadata__item">Status hoofdzaak: {{hoofdzaakStatusLabel}}</li>
      {{#hoofdzaakEmail}}<li class="nijmegen-metadata__item">E-mailadres hoofdzaak: {{hoofdzaakEmail}}</li>{{/hoofdzaakEmail}}
    </ul>
    {{#hoofdzaakSourceMissing}}
    <p class="utrecht-paragraph">De aanvraaggegevens van deze hoofdzaak konden niet volledig worden geladen. Het dossier bestaat wel. Controleer het kenmerk extra zorgvuldig.</p>
    {{/hoofdzaakSourceMissing}}
    <p class="utrecht-paragraph">Controleer of dit het juiste project is voordat u koppelt.</p>
    {{#canManage}}
    <form method="post" action="/woonbehoefte/additional-evidence/{{submissionId}}/link">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="targetCaseReference" value="{{caseReference}}">
      <input type="hidden" name="back" value="{{backQuery}}">
      <button type="submit" class="utrecht-button utrecht-button--primary-action">Koppel extra bewijzen aan deze hoofdzaak</button>
    </form>
    {{/canManage}}
    {{/found}}
    {{^found}}
    <div class="utrecht-alert utrecht-alert--error" role="status">
      <div class="utrecht-alert__content">
        <p class="utrecht-alert__message">Geen hoofdzaak gevonden met kenmerk {{searchedReference}}. Controleer het kenmerk en probeer opnieuw. De extra bewijzen zijn niet gekoppeld.</p>
      </div>
    </div>
    {{/found}}
    </div>
    {{/searched}}
    {{/caseLookup}}
    {{/isLinked}}
  </details>

  <details id="bestanden" class="woonbehoefte-details woonbehoefte-details--section" open>
    <summary class="utrecht-heading-4">Bestanden</summary>

    <h3 class="utrecht-heading-5">Extra-bewijzenformulier</h3>
    {{#applicationDocument}}
    <ul class="woonbehoefte-documents">
      <li class="woonbehoefte-documents__item woonbehoefte-documents__item--pdf">
        <a class="utrecht-link" href="{{downloadHref}}">{{filenameLabel}}</a>
        <span class="woonbehoefte-documents__meta">
          {{#formatLabel}}{{formatLabel}}{{/formatLabel}}{{#sizeLabel}} · {{sizeLabel}}{{/sizeLabel}}
        </span>
      </li>
    </ul>
    {{/applicationDocument}}
    {{^applicationDocument}}
    <p class="utrecht-paragraph">Geen PDF beschikbaar voor deze inzending.</p>
    {{/applicationDocument}}

    <h3 class="utrecht-heading-5">Bijlagen</h3>
    {{#hasAttachments}}
    <ul class="woonbehoefte-documents">
      {{#attachments}}
      <li class="woonbehoefte-documents__item">
        <a class="utrecht-link" href="{{downloadHref}}">{{filenameLabel}}</a>
        <span class="woonbehoefte-documents__meta">
          {{#formatLabel}}{{formatLabel}}{{/formatLabel}}{{#sizeLabel}} · {{sizeLabel}}{{/sizeLabel}}
        </span>
      </li>
      {{/attachments}}
    </ul>
    {{/hasAttachments}}
    {{^hasAttachments}}
    <p class="utrecht-paragraph">Geen bijlagen beschikbaar voor deze inzending.</p>
    {{/hasAttachments}}
  </details>
</main>
{{>footer}}
