{{>header}}
<main id="main-content" class="woonbehoefte-detail">
  <p><a class="utrecht-link" href="{{backHref}}">Terug naar werkvoorraad</a></p>

  <div class="woonbehoefte-detail-header">
    <p class="woonbehoefte-detail-header__reference">
      {{caseReference}}
      <span class="woonbehoefte-badge woonbehoefte-badge--{{statusToken}}">{{statusLabel}}</span>
    </p>
    <h1 class="utrecht-heading-2">{{projectName}}</h1>
  </div>

  {{#showStaleWarning}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">Deze wijziging kon niet worden opgeslagen: de aanvraag is ondertussen door iemand anders gewijzigd. Ververs de pagina en probeer het opnieuw.</p>
    </div>
  </div>
  {{/showStaleWarning}}

  {{#savedMessage}}
  <div class="utrecht-alert utrecht-alert--success" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">{{savedMessage}}</p>
    </div>
  </div>
  {{/savedMessage}}

  {{^hasSource}}
  <div class="utrecht-alert utrecht-alert--warning" role="status">
    <div class="utrecht-alert__content">
      <p class="utrecht-alert__message">{{sourceErrorMessage}}</p>
    </div>
  </div>
  {{/hasSource}}

  <section id="basisgegevens" class="woonbehoefte-section">
    <h2 class="utrecht-heading-4">Basisgegevens</h2>
    <dl class="woonbehoefte-basics-grid">
      <div class="woonbehoefte-basics-grid__item">
        <dt>Status</dt>
        <dd>
          <span class="woonbehoefte-badge woonbehoefte-badge--{{statusToken}}">{{statusLabel}}</span>
          <span class="woonbehoefte-detail-summary__meta">Status sinds {{statusSinceLabel}}</span>
        </dd>
      </div>
      <div class="woonbehoefte-basics-grid__item">
        <dt>Behandelaar</dt>
        <dd{{#isUnclaimed}} class="woonbehoefte-unclaimed"{{/isUnclaimed}}>
          <span>{{assigneeLabel}}</span>
          {{#canManage}}
          {{#canClaim}}
          <form method="post" action="/woonbehoefte/cases/{{caseReference}}/claim" class="woonbehoefte-inline-form">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            <input type="hidden" name="expectedVersion" value="{{version}}">
            <input type="hidden" name="back" value="{{backQuery}}">
            <button type="submit" class="utrecht-button utrecht-button--secondary-action">Aanvraag oppakken</button>
          </form>
          {{/canClaim}}
          {{#canRelease}}
          <form method="post" action="/woonbehoefte/cases/{{caseReference}}/release" class="woonbehoefte-inline-form">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            <input type="hidden" name="expectedVersion" value="{{version}}">
            <input type="hidden" name="back" value="{{backQuery}}">
            <button type="submit" class="utrecht-button utrecht-button--secondary-action">Claim vrijgeven</button>
          </form>
          {{/canRelease}}
          {{#canTakeOver}}
          <form method="post" action="/woonbehoefte/cases/{{caseReference}}/take-over" class="woonbehoefte-inline-form">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            <input type="hidden" name="expectedVersion" value="{{version}}">
            <input type="hidden" name="back" value="{{backQuery}}">
            <button type="submit" class="utrecht-button utrecht-button--secondary-action">Behandeling overnemen</button>
          </form>
          {{/canTakeOver}}
          {{/canManage}}
        </dd>
      </div>
      <div class="woonbehoefte-basics-grid__item">
        <dt>Ontvangen</dt>
        <dd>{{receivedLabel}}</dd>
      </div>
      <div class="woonbehoefte-basics-grid__item">
        <dt>Type aanvrager</dt>
        <dd>{{applicantTypeLabel}}</dd>
      </div>
      {{#collectiveHousingLabel}}
      <div class="woonbehoefte-basics-grid__item">
        <dt>Collectieve woonvorm</dt>
        <dd>{{collectiveHousingLabel}}{{#collectiveHousingCategory}} ({{collectiveHousingCategory}}){{/collectiveHousingCategory}}</dd>
      </div>
      {{/collectiveHousingLabel}}
    </dl>

    {{#canManage}}
    <div class="woonbehoefte-actions">
      {{#canUseGenericStatusSelect}}
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/status" class="woonbehoefte-inline-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="expectedVersion" value="{{version}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <div class="utrecht-form-field">
          <label class="utrecht-form-label" for="status-select">Status wijzigen</label>
          <select class="utrecht-select utrecht-select--html-select" id="status-select" name="status">
            {{#statusOptions}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/statusOptions}}
          </select>
        </div>
        <button type="submit" class="utrecht-button utrecht-button--secondary-action">Opslaan</button>
      </form>
      {{/canUseGenericStatusSelect}}

      {{#isInadmissible}}
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/status" class="woonbehoefte-inline-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="expectedVersion" value="{{version}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <input type="hidden" name="status" value="IN_PROGRESS">
        <button type="submit" class="utrecht-button utrecht-button--secondary-action">Heropenen als in behandeling</button>
      </form>
      {{/isInadmissible}}

      {{#isProposedInadmissible}}
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/inadmissible/confirm" class="woonbehoefte-inline-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="expectedVersion" value="{{version}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <button type="submit" class="utrecht-button utrecht-button--primary-action">Niet-ontvankelijk bevestigen</button>
      </form>
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/status" class="woonbehoefte-inline-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="expectedVersion" value="{{version}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <input type="hidden" name="status" value="IN_PROGRESS">
        <button type="submit" class="utrecht-button utrecht-button--secondary-action">Voorstel intrekken</button>
      </form>
      {{/isProposedInadmissible}}
    </div>

    {{#canUseGenericStatusSelect}}
    <details class="woonbehoefte-details">
      <summary>Voorstellen als niet-ontvankelijk</summary>
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/status" class="woonbehoefte-inadmissible-form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="expectedVersion" value="{{version}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <input type="hidden" name="status" value="PROPOSED_INADMISSIBLE">
        <div class="utrecht-form-field">
          <label class="utrecht-form-label" for="motivering">Motivering (verplicht)</label>
          <textarea class="utrecht-textarea" id="motivering" name="motivering" rows="3" required></textarea>
        </div>
        <button type="submit" class="utrecht-button utrecht-button--secondary-action">Voorstellen als niet-ontvankelijk</button>
      </form>
    </details>
    {{/canUseGenericStatusSelect}}
    {{/canManage}}
  </section>

  <details class="woonbehoefte-details woonbehoefte-details--section">
    <summary class="utrecht-heading-4">Op deze pagina</summary>
    <nav class="nijmegen-table-of-contents" aria-label="Op deze pagina">
      <a class="utrecht-link" href="#basisgegevens">Basisgegevens</a>
      <a class="utrecht-link" href="#aanvraag">Aanvraaggegevens</a>
      <a class="utrecht-link" href="#projectdetails">Projectdetails voor Mijn Aansluiting</a>
      <a class="utrecht-link" href="#projectdetails-wonen">Wonen Mijn Aansluiting</a>
      <a class="utrecht-link" href="#projectdetails-voorziening">Collectieve voorzieningen Mijn Aansluiting</a>
      <a class="utrecht-link" href="#projectdetails-kova">KOVA Mijn Aansluiting</a>
      <a class="utrecht-link" href="#check">Check</a>
      <a class="utrecht-link" href="#documenten">Documenten</a>
      <a class="utrecht-link" href="#beoordeling">Beoordeling</a>
      <a class="utrecht-link" href="#planning">Planning</a>
      <a class="utrecht-link" href="#aantekeningen">Interne aantekeningen</a>
      <a class="utrecht-link" href="#activiteit">Wijzigingen en activiteit</a>
    </nav>
  </details>

  <details id="aanvraag" class="woonbehoefte-details woonbehoefte-details--section" open>
    <summary class="utrecht-heading-4">Aanvraaggegevens</summary>
    <dl class="woonbehoefte-detail-summary">
      {{#projectDescription}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>Beschrijving</dt>
        <dd>{{projectDescription}}</dd>
      </div>
      {{/projectDescription}}
      {{#contactName}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>Contactpersoon</dt>
        <dd>{{contactName}}{{#contactPhone}} · {{contactPhone}}{{/contactPhone}}{{#contactEmail}} · {{contactEmail}}{{/contactEmail}}</dd>
      </div>
      {{/contactName}}
      {{#totalHomesLabel}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>Aantal woningen</dt>
        <dd>{{totalHomesLabel}}</dd>
      </div>
      {{/totalHomesLabel}}
      {{#hasExistingLianderRequestLabel}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>Lopende aanvraag Liander</dt>
        <dd>{{hasExistingLianderRequestLabel}}{{#eanOrApplicationNumber}} ({{eanOrApplicationNumber}}){{/eanOrApplicationNumber}}</dd>
      </div>
      {{/hasExistingLianderRequestLabel}}
      {{#hasCollectiveFacilitiesLabel}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>Collectieve voorzieningen</dt>
        <dd>{{hasCollectiveFacilitiesLabel}}</dd>
      </div>
      {{/hasCollectiveFacilitiesLabel}}
      {{#hasKovaLabel}}
      <div class="woonbehoefte-detail-summary__row">
        <dt>KOVA</dt>
        <dd>{{hasKovaLabel}}</dd>
      </div>
      {{/hasKovaLabel}}
    </dl>
  </details>

  {{#projectDetails}}
  <section id="projectdetails" class="woonbehoefte-section woonbehoefte-project-details">
    <h2 class="utrecht-heading-4">Projectdetails voor Mijn Aansluiting</h2>
    <p class="utrecht-paragraph">Werkversie voor handmatige invoer bij MijnAansluiting.nl. Wijzigt nooit de oorspronkelijke aanvraag.</p>
    {{#isReady}}
    <p class="utrecht-paragraph">Elk onderdeel hieronder heeft een eigen Opslaan-knop. Een paginaverversing zonder op te slaan verliest wijzigingen in andere onderdelen.</p>
    {{/isReady}}

    {{#isUnavailable}}
    <div class="utrecht-alert utrecht-alert--error" role="status">
      <div class="utrecht-alert__content">
        <p class="utrecht-alert__message">Projectdetails kon niet worden geladen. Ververs de pagina; de rest van de aanvraag blijft beschikbaar.</p>
      </div>
    </div>
    {{/isUnavailable}}

    {{#isNew}}
    <p class="utrecht-paragraph">Nog geen werkversie voor dit dossier.</p>
    {{#canManage}}
    <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/start" class="woonbehoefte-inline-form">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="back" value="{{backQuery}}">
      <button type="submit" class="utrecht-button utrecht-button--secondary-action">Projectdetails voorinvullen</button>
    </form>
    <p class="utrecht-paragraph woonbehoefte-project-details__note">Werkt de bron blijvend niet? Begin dan handmatig met een lege werkversie.</p>
    <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/start-empty" class="woonbehoefte-inline-form">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="back" value="{{backQuery}}">
      <button type="submit" class="utrecht-button utrecht-button--secondary-action">Handmatig leeg beginnen</button>
    </form>
    {{/canManage}}
    {{/isNew}}

    {{#isPending}}
    <p class="utrecht-paragraph">Voorinvulling loopt. Ververs de pagina zo nodig.</p>
    {{/isPending}}

    {{#isFailed}}
    <div class="utrecht-alert utrecht-alert--warning" role="status">
      <div class="utrecht-alert__content">
        <p class="utrecht-alert__message">Voorinvulling is mislukt. Probeer het opnieuw of vul de werkversie handmatig in vanaf de aanvraag-PDF.</p>
      </div>
    </div>
    {{#canManage}}
    <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/start" class="woonbehoefte-inline-form">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="back" value="{{backQuery}}">
      <button type="submit" class="utrecht-button utrecht-button--secondary-action">Opnieuw proberen</button>
    </form>
    <p class="utrecht-paragraph woonbehoefte-project-details__note">Blijft dit mislukken? Begin dan handmatig met een lege werkversie.</p>
    <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/start-empty" class="woonbehoefte-inline-form">
      <input type="hidden" name="csrfToken" value="{{csrfToken}}">
      <input type="hidden" name="back" value="{{backQuery}}">
      <button type="submit" class="utrecht-button utrecht-button--secondary-action">Handmatig leeg beginnen</button>
    </form>
    {{/canManage}}
    {{/isFailed}}

    {{#isReady}}
    <details id="pd-additional-information-card" class="woonbehoefte-details woonbehoefte-details--section" open>
      <summary class="utrecht-heading-4">Aanvullende informatie voor Mijn Aansluiting</summary>
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/additional-information" class="woonbehoefte-project-details__form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <div class="utrecht-form-field">
          <label class="utrecht-form-label" for="pd-additional-information">Aanvullende informatie voor Mijn Aansluiting</label>
          <textarea class="utrecht-textarea" id="pd-additional-information" name="additionalInformation" rows="2" {{^canManage}}readonly{{/canManage}}>{{additionalInformation}}</textarea>
        </div>
        {{#canManage}}
        <button type="submit" class="utrecht-button utrecht-button--primary-action">Opslaan</button>
        {{/canManage}}
      </form>
    </details>

    <details id="pd-project-card" class="woonbehoefte-details woonbehoefte-details--section" open>
      <summary class="utrecht-heading-4">Project</summary>
      <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/project" class="woonbehoefte-project-details__form">
        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
        <input type="hidden" name="back" value="{{backQuery}}">
        <div class="utrecht-form-field">
          <label class="utrecht-form-label" for="pd-readable-name">Leesbare projectnaam</label>
          <input class="utrecht-textbox" type="text" id="pd-readable-name" name="readableProjectName" value="{{readableProjectName}}" {{^canManage}}readonly{{/canManage}}>
        </div>
        <div class="utrecht-form-field">
          <span class="utrecht-form-label">Volledige projectnaam</span>
          <p class="utrecht-paragraph woonbehoefte-project-details__full-name">{{fullProjectName}}</p>
        </div>
        <div class="utrecht-form-field">
          <label class="utrecht-form-label" for="pd-description">Projecttoelichting</label>
          <textarea class="utrecht-textarea" id="pd-description" name="projectDescription" rows="3" {{^canManage}}readonly{{/canManage}}>{{projectDescription}}</textarea>
        </div>
        {{#canManage}}
        <button type="submit" class="utrecht-button utrecht-button--primary-action">Opslaan</button>
        {{/canManage}}
      </form>
    </details>

    <details id="projectdetails-wonen" class="woonbehoefte-details woonbehoefte-details--section" open>
      <summary class="utrecht-heading-4">Wonen</summary>
      <div class="woonbehoefte-project-details__category-header">
        {{#canManage}}
        <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/wonen" class="woonbehoefte-inline-form">
          <input type="hidden" name="csrfToken" value="{{csrfToken}}">
          <input type="hidden" name="back" value="{{backQuery}}">
          <input type="hidden" name="type" value="WOONHUIS">
          <input type="hidden" name="connectionCount" value="0">
          <input type="hidden" name="connectionType" value="">
          <input type="hidden" name="otherDetails" value="">
          <button type="submit" class="utrecht-button utrecht-button--secondary-action">Toevoegen wonen</button>
        </form>
        {{/canManage}}
      </div>
      {{^hasHousingLines}}
      <p class="utrecht-paragraph">Nog geen woonregels.</p>
      {{/hasHousingLines}}
      {{#housingLines}}
      <details id="pd-wonen-line-{{lineId}}" class="woonbehoefte-details woonbehoefte-project-details__line" open>
        <summary class="woonbehoefte-project-details__line-heading">Wonen regel {{number}}</summary>
        <form id="pd-wonen-edit-{{lineId}}" method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/wonen/{{lineId}}" class="woonbehoefte-project-details__form">
          <input type="hidden" name="csrfToken" value="{{csrfToken}}">
          <input type="hidden" name="back" value="{{backQuery}}">
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-wonen-type-{{lineId}}">Type</label>
            <select class="utrecht-select utrecht-select--html-select" id="pd-wonen-type-{{lineId}}" name="type" {{^canManage}}disabled{{/canManage}}>
              {{#typeOptions}}
              <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
              {{/typeOptions}}
            </select>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-wonen-count-{{lineId}}">Aantal aansluitingen</label>
            <input class="utrecht-textbox" type="number" min="0" id="pd-wonen-count-{{lineId}}" name="connectionCount" value="{{connectionCount}}" {{^canManage}}readonly{{/canManage}}>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-wonen-connection-{{lineId}}">Type aansluiting</label>
            <input class="utrecht-textbox" type="text" id="pd-wonen-connection-{{lineId}}" name="connectionType" value="{{connectionType}}" {{^canManage}}readonly{{/canManage}}>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-wonen-details-{{lineId}}">Overige gegevens</label>
            <textarea class="utrecht-textarea" id="pd-wonen-details-{{lineId}}" name="otherDetails" rows="4" {{^canManage}}readonly{{/canManage}}>{{otherDetails}}</textarea>
          </div>
          {{#homesAccordingToFormLabel}}
          <p class="woonbehoefte-project-details__note">Aantal woningen volgens formulier: {{homesAccordingToFormLabel}}</p>
          {{/homesAccordingToFormLabel}}
        </form>
        {{#canManage}}
        <div class="woonbehoefte-project-details__line-actions">
          <button type="submit" form="pd-wonen-edit-{{lineId}}" class="utrecht-button utrecht-button--primary-action">Opslaan</button>
          <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/wonen/{{lineId}}/delete" class="woonbehoefte-inline-form" onsubmit="return confirm('Deze woonregel verwijderen?')">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            <input type="hidden" name="back" value="{{backQuery}}">
            <button type="submit" class="utrecht-button utrecht-button--secondary-action">Verwijderen</button>
          </form>
        </div>
        {{/canManage}}
      </details>
      {{/housingLines}}
    </details>

    <details id="projectdetails-voorziening" class="woonbehoefte-details woonbehoefte-details--section" open>
      <summary class="utrecht-heading-4">Collectieve voorzieningen</summary>
      <div class="woonbehoefte-project-details__category-header">
        {{#canManage}}
        <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/voorziening" class="woonbehoefte-inline-form">
          <input type="hidden" name="csrfToken" value="{{csrfToken}}">
          <input type="hidden" name="back" value="{{backQuery}}">
          <input type="hidden" name="facilityType" value="Nieuwe voorziening">
          <input type="hidden" name="connectionCount" value="1">
          <input type="hidden" name="connectionType" value="">
          <input type="hidden" name="otherDetails" value="">
          <button type="submit" class="utrecht-button utrecht-button--secondary-action">Toevoegen voorziening</button>
        </form>
        {{/canManage}}
      </div>
      {{^hasFacilityLines}}
      <p class="utrecht-paragraph">Nog geen collectieve voorzieningen.</p>
      {{/hasFacilityLines}}
      {{#facilityLines}}
      <details id="pd-voorziening-line-{{lineId}}" class="woonbehoefte-details woonbehoefte-project-details__line" open>
        <summary class="woonbehoefte-project-details__line-heading">Voorziening regel {{number}}</summary>
        <form id="pd-voorziening-edit-{{lineId}}" method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/voorziening/{{lineId}}" class="woonbehoefte-project-details__form">
          <input type="hidden" name="csrfToken" value="{{csrfToken}}">
          <input type="hidden" name="back" value="{{backQuery}}">
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-voorziening-type-{{lineId}}">Type</label>
            <input class="utrecht-textbox" type="text" id="pd-voorziening-type-{{lineId}}" name="facilityType" value="{{facilityType}}" {{^canManage}}readonly{{/canManage}}>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-voorziening-count-{{lineId}}">Aantal aansluitingen</label>
            <input class="utrecht-textbox" type="number" min="0" id="pd-voorziening-count-{{lineId}}" name="connectionCount" value="{{connectionCount}}" {{^canManage}}readonly{{/canManage}}>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-voorziening-connection-{{lineId}}">Type aansluiting</label>
            <input class="utrecht-textbox" type="text" id="pd-voorziening-connection-{{lineId}}" name="connectionType" value="{{connectionType}}" {{^canManage}}readonly{{/canManage}}>
          </div>
          <div class="utrecht-form-field">
            <label class="utrecht-form-label" for="pd-voorziening-details-{{lineId}}">Overige gegevens</label>
            <textarea class="utrecht-textarea" id="pd-voorziening-details-{{lineId}}" name="otherDetails" rows="4" {{^canManage}}readonly{{/canManage}}>{{otherDetails}}</textarea>
          </div>
        </form>
        {{#canManage}}
        <div class="woonbehoefte-project-details__line-actions">
          <button type="submit" form="pd-voorziening-edit-{{lineId}}" class="utrecht-button utrecht-button--primary-action">Opslaan</button>
          <form method="post" action="/woonbehoefte/cases/{{caseReference}}/project-details/lines/voorziening/{{lineId}}/delete" class="woonbehoefte-inline-form" onsubmit="return confirm('Deze voorziening verwijderen?')">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            <input type="hidden" name="back" value="{{backQuery}}">
            <button type="submit" class="utrecht-button utrecht-button--secondary-action">Verwijderen</button>
          </form>
