      <li class="woonbehoefte-notes__item">
        <p class="woonbehoefte-notes__meta">{{categoryLabel}} · {{createdByLabel}} · {{createdAtLabel}}</p>
        <p class="utrecht-paragraph">{{text}}</p>
      </li>
      {{/notes}}
    </ul>
    {{/hasNotes}}
    {{^hasNotes}}
    <p class="utrecht-paragraph">Er zijn nog geen interne aantekeningen.</p>
    {{/hasNotes}}
  </details>

  <details id="activiteit" class="woonbehoefte-details woonbehoefte-details--section">
    <summary class="utrecht-heading-4">Wijzigingen en activiteit</summary>
    {{#hasActivities}}
    <ul class="woonbehoefte-activities">
      {{#activities}}
      <li class="woonbehoefte-activities__item">
        <p class="woonbehoefte-activities__meta">{{occurredAtLabel}} - {{actor}}</p>
        <p class="utrecht-paragraph">{{summary}}</p>
        {{#changeLines}}
        <p class="woonbehoefte-activities__change">{{.}}</p>
        {{/changeLines}}
      </li>
      {{/activities}}
    </ul>
    {{/hasActivities}}
    {{^hasActivities}}
    <p class="utrecht-paragraph">Nog geen activiteit voor deze aanvraag.</p>
    {{/hasActivities}}
  </details>
</main>
{{>footer}}
