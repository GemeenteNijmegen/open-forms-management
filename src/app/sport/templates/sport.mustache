{{>header}}
<main id="main-content">
  <h1>Sport</h1>

  <nav class="sport-tabs" aria-label="Sportnavigatie">
    <a class="sport-tabs__link{{#isAanmeldingenTab}} sport-tabs__link--active{{/isAanmeldingenTab}}" href="/sport"{{#isAanmeldingenTab}} aria-current="page"{{/isAanmeldingenTab}}>Aanmeldingen</a>
    <a class="sport-tabs__link{{#isOverzichtenTab}} sport-tabs__link--active{{/isOverzichtenTab}}" href="/sport/overzichten"{{#isOverzichtenTab}} aria-current="page"{{/isOverzichtenTab}}>Excel-overzichten</a>
  </nav>

  {{#hasAccessToAllDistricts}}
  <p class="utrecht-paragraph">Je ziet aanmeldingen vanaf {{visibleFromLabel}}, uit alle wijken.</p>
  {{/hasAccessToAllDistricts}}
  {{^hasAccessToAllDistricts}}
  <p class="utrecht-paragraph">Je ziet aanmeldingen vanaf {{visibleFromLabel}}, voor de wijken waar je toegang toe hebt:</p>
  <ul class="nijmegen-metadata nijmegen-metadata__horizontal">
    {{#allowedDistrictLabels}}
    <li class="nijmegen-metadata__item">{{.}}</li>
    {{/allowedDistrictLabels}}
  </ul>
  {{/hasAccessToAllDistricts}}

  <details class="sport-filter">
    <summary class="utrecht-form-label">Filteren op wijk en type</summary>
    <form method="get" action="/sport">
      <input type="hidden" name="filterSubmitted" value="1">
      <fieldset>
        <legend class="utrecht-form-label">Wijken</legend>
        {{#districtOptions}}
        <div class="utrecht-form-field utrecht-form-field--checkbox">
          <input type="checkbox" class="utrecht-form-field__input" id="district-{{value}}" name="district" value="{{value}}" {{#checked}}checked{{/checked}}>
          <label class="utrecht-form-field__label utrecht-form-label utrecht-form-label--checkbox" for="district-{{value}}">{{label}}</label>
        </div>
        {{/districtOptions}}
      </fieldset>
      <fieldset>
        <legend class="utrecht-form-label">Type</legend>
        {{#typeOptions}}
        <div class="utrecht-form-field utrecht-form-field--checkbox">
          <input type="checkbox" class="utrecht-form-field__input" id="type-{{value}}" name="type" value="{{value}}" {{#checked}}checked{{/checked}}>
          <label class="utrecht-form-field__label utrecht-form-label utrecht-form-label--checkbox" for="type-{{value}}">{{label}}</label>
        </div>
        {{/typeOptions}}
      </fieldset>
      <button type="submit" class="utrecht-button utrecht-button--primary-action sport-filter__submit">Filteren</button>
    </form>
  </details>

  <div class="sport-refresh-bar">
    <button type="button" id="sport-refresh-button" class="utrecht-button utrecht-button--secondary-action">Vernieuwen</button>
    <p id="sport-refresh-status" class="sport-loading" role="status" hidden></p>
  </div>

  <div id="sport-submissions" aria-live="polite" aria-busy="true">
    <p class="sport-loading">Aanmeldingen laden…</p>
  </div>
</main>
<script src="/static/js/sport-submissions.js" defer></script>
{{>footer}}
